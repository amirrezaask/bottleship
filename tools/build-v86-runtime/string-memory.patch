+// Only bound by the host when get_string_memory_abi() is supported.
+unsafe fn handle_strchr_native<const REVERSE: bool>() -> bool {
+    let esp = read_reg32(ESP);
+    let Ok(src) = safe_read32s(esp.wrapping_add(4)) else { return false; };
+    let Ok(ch) = safe_read32s(esp.wrapping_add(8)) else { return false; };
+    if src == 0 { write_reg32(EAX, 0); return true; }
+    if let Some(p) = super::string_memory::try_find::<false, REVERSE>(src as u32, ch as u8 as u32) {
+        write_reg32(EAX, p as i32);
+        return true;
+    }
+    false
+}
