 /// (0x8000000000000000), whose low 32 bits are 0. Rust `as i64` saturates
 /// (wrong for the guest), so the out-of-range cases are handled explicitly.
 #[inline(always)]
+unsafe fn handle_max_payne_tree_find() -> bool {
+    const SENTINEL_POINTER: i32 = 0x008A_E3CC;
+    const MAX_VISITED_NODES: usize = 4096;
+
+    let object = read_reg32(ECX);
+    let esp = read_reg32(ESP);
+    let key_pointer = match safe_read32s(esp.wrapping_add(4)) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+    let key = match safe_read32s(key_pointer) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+    let header = match safe_read32s(object.wrapping_add(4)) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+    let mut candidate = header;
+    let mut node = match safe_read32s(header.wrapping_add(4)) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+    let sentinel = match safe_read32s(SENTINEL_POINTER) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+
+    for _ in 0..MAX_VISITED_NODES {
+        if node == sentinel {
+            write_reg32(EAX, candidate);
+            return true;
+        }
+        let node_key = match safe_read32s(node.wrapping_add(12)) {
+            Ok(value) => value,
+            Err(_) => return false,
+        };
+        if node_key < key {
+            node = match safe_read32s(node.wrapping_add(8)) {
+                Ok(value) => value,
+                Err(_) => return false,
+            };
+        }
+        else {
+            candidate = node;
+            node = match safe_read32s(node) {
+                Ok(value) => value,
+                Err(_) => return false,
+            };
+        }
+    }
+
+    // Corrupt/cyclic or unexpectedly deep trees retain the original guest path.
+    false
+}
