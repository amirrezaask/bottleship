+// The heat counter is reset by tier-2 policy as well as when a slot is freed.
+// Drain it before each policy reset; otherwise the next wrapping subtraction
+// invents nearly 2^32 executions. Sampling remains off the generated RET path.
+fn sample_slot(s: &mut State, slot_index: usize, executions: u32) {
+    let state = &mut s.slots[slot_index];
+    let Some(key) = state.key else { return };
+    let delta = executions.wrapping_sub(state.sampled_executions) as u64;
+    state.sampled_executions = executions;
+    if delta != 0 {
+        if let Some(profile) = profile_mut(s, key) {
+            profile.executions = profile.executions.saturating_add(delta);
+            profile.pending_activity = true;
+        }
+    }
+}
+
+#[cfg(test)]
+mod profile_counter_tests {
+    use super::*;
+
+    #[test]
+    fn natural_counter_wrap_is_distinct_from_a_policy_reset() {
+        let mut state = State::default();
+        let key = (0x401000, 7);
+        register_slot(&mut state, WasmTableIndex(1), key, false, 0);
+        state.slots[1].sampled_executions = u32::MAX - 2;
+        sample_slot(&mut state, 1, 4);
+        assert_eq!(state.profiles[&key].executions, 7);
+        sample_slot(&mut state, 1, 4);
+        assert_eq!(state.profiles[&key].executions, 7);
+        assert!(state.profiles[&key].pending_activity);
+    }
 }
 
+pub fn reset_slot_counter(slot: WasmTableIndex, executions: u32) {
+    with_state(|s| {
+        let index = slot.to_u16() as usize;
+        sample_slot(s, index, executions);
+        s.slots[index].sampled_executions = 0;
+    });
+}
